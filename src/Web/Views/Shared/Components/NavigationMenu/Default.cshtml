@using Rakit.Web.ViewComponents
@model IReadOnlyList<NavEntry>

@* The menu from rakit.Menus as sidebar entries: an item is a link, a folder opens its children, a delimiter is a divider.
   The icon is a Bootstrap Icons name (already checked by the view component). *@
@foreach (var item in Model)
{
    if (item.IsDelimiter)
    {
        <div class="rk-divider" role="separator"></div>
    }
    else if (item.Children.Count > 0)
    {
        <div class="rk-group @(item.IsActive ? "has-active is-open" : "")">
            <button type="button" class="rk-group-toggle" data-key="@item.Label" aria-expanded="@(item.IsActive ? "true" : "false")">
                <i class="bi @(item.Icon ?? "bi-folder2")"></i>
                <span>@item.Label</span>
                <i class="bi bi-chevron-right rk-chevron"></i>
            </button>
            <div class="rk-sub">
                @foreach (var child in item.Children)
                {
                    if (child.IsDelimiter)
                    {
                        <div class="rk-divider" role="separator" style="margin: .4rem .6rem"></div>
                    }
                    else
                    {
                        <a class="rk-link @(child.IsActive ? "active" : "")" href="@child.Href"><i class="bi @(child.Icon ?? "bi-dot")"></i><span>@child.Label</span></a>
                    }
                }
            </div>
        </div>
    }
    else
    {
        <a class="rk-link @(item.IsActive ? "active" : "")" href="@item.Href"><i class="bi @(item.Icon ?? "bi-app-indicator")"></i><span>@item.Label</span></a>
    }
}
