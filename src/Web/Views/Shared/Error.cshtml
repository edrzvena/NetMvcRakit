@model ErrorViewModel
@{
    ViewData["Title"] = "Terjadi kesalahan";
}

<div class="rk-card p-4 p-md-5 text-center mx-auto" style="max-width: 40rem">
    <i class="bi bi-emoji-frown display-4 text-muted"></i>
    <h1 class="h3 mt-3">Terjadi kesalahan</h1>
    <p class="text-muted">Permintaan Anda tidak dapat diproses. Coba lagi sebentar lagi; kalau masih terjadi, sebutkan kode di bawah ini ke pengelola.</p>

    @if (Model.ShowRequestId)
    {
        <p class="mb-3"><span class="text-muted">Kode permintaan:</span> <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Kembali ke beranda</a>
</div>
