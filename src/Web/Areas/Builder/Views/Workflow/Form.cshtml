@using Rakit.Core.Workflows
@using System.Text.Json
@model WorkflowFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? $"Ubah {Model.Name}" : "Workflow baru";
    var sources = JsonSerializer.Serialize(Model.DataSources.Select(s => new { id = s.Id, label = s.Label }));
    var moduleOptions = JsonSerializer.Serialize(Model.Modules.Select(s => new { id = s.Id, label = s.Label }));
}

<p><a asp-area="Builder" asp-controller="Workflow" asp-action="Index">&larr; Workflow</a></p>
<h1 class="h3 mb-3">
    @(Model.IsEdit ? "Ubah Workflow" : "Workflow baru")
    @if (Model.IsEdit)
    {
        <span class="badge fs-6 @(Model.Status == WorkflowStatus.Published ? "bg-success" : "bg-secondary")">@WorkflowDisplayText.StatusLabel(Model.Status)</span>
    }
</h1>

<div asp-validation-summary="All" class="alert alert-danger"></div>

@if (Model.IsEdit && Model.Status == WorkflowStatus.Published)
{
    <div class="alert alert-info" role="note">
        Workflow ini <strong>Published</strong>: perubahan yang disimpan langsung berlaku untuk tombol yang menjalankannya, jadi
        perubahan harus lolos pemeriksaan yang sama dengan Publish. Untuk mengerjakannya tanpa mengganggu pengguna, salin dulu lalu ubah salinan draft-nya.
    </div>
}

<form id="workflow-form" method="post" asp-area="Builder" asp-controller="Workflow" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input type="hidden" id="StepsJson" name="StepsJson" value="@Model.StepsJson" />

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label" for="Code">Kode</label>
            <input class="form-control" id="Code" name="Code" value="@Model.Code" maxlength="@WorkflowInputValidator.MaxCodeLength" required />
            <div class="form-text">Huruf, angka, <code>_</code> atau <code>-</code>; unik.</div>
        </div>
        <div class="col-md-5">
            <label class="form-label" for="Name">Nama</label>
            <input class="form-control" id="Name" name="Name" value="@Model.Name" maxlength="@WorkflowInputValidator.MaxNameLength" required />
        </div>
        <div class="col-md-4">
            <label class="form-label d-block">Transaksi</label>
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="Transaction" name="Transaction" value="true" checked="@Model.Transaction" />
                <input type="hidden" name="Transaction" value="false" />
                <label class="form-check-label" for="Transaction">Satu transaksi untuk semua langkah database</label>
            </div>
            <div class="form-text">
                Bila salah satu langkah gagal, semua perubahan langkah data source dibatalkan (rollback). Langkah Rest dan Email tidak bisa dibatalkan.
                Tidak bisa dipakai bersama langkah <em>Form</em> (alur berhenti menunggu pengunjung).
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="Description">Deskripsi</label>
        <textarea class="form-control" id="Description" name="Description" rows="2" maxlength="@WorkflowInputValidator.MaxDescriptionLength">@Model.Description</textarea>
    </div>

    <div class="border rounded p-3 mb-3">
        <h2 class="h5">Alur</h2>
        <p class="small text-muted mb-2">
            Tambah langkah dari tombol di bawah, geser kotaknya, lalu sambungkan: tarik dari titik di <strong>sisi kanan</strong> sebuah langkah ke
            <strong>sisi kiri</strong> langkah berikutnya (atau pilih "Berikutnya" di panel kanan). Langkah <em>Kondisi</em> punya dua keluaran:
            <span class="text-success fw-semibold">Ya</span> dan <span class="text-danger fw-semibold">Tidak</span>; keluaran yang tidak disambung
            mengakhiri workflow. Alur berjalan dari langkah yang disambung ke <strong>Mulai</strong>.
            Klik sambungan lalu tekan <kbd>Delete</kbd> untuk melepasnya.
        </p>

        <div class="d-flex flex-wrap gap-1 align-items-center mb-2" id="wf-toolbar">
            <span class="small text-muted me-1">Tambah:</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add="dataSource">Data source</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add="rest">Rest</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add="email">Email</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add="condition">Kondisi</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add="page">Halaman</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add="module">Module</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add="javascript" title="Skrip JavaScript yang dijalankan di server">Skrip</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add="action" title="Berhenti dan tampilkan form ke pengunjung">Form</button>
            <span class="mx-2 text-muted">|</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="wf-layout">Rapikan</button>
            <button type="button" class="btn btn-sm btn-outline-info" id="check-steps">Periksa</button>
            <span id="check-status" class="ms-2 small text-muted" aria-live="polite"></span>
        </div>

        <div class="wf-layout" id="wf-root" data-sources="@sources" data-modules="@moduleOptions">
            <div class="wf-canvas" id="wf-canvas" tabindex="0" aria-label="Kanvas alur workflow">
                <svg id="wf-edges" class="wf-edges" aria-hidden="true">
                    <defs>
                        <marker id="wf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                            <path d="M 0 0 L 10 5 L 0 10 z" fill="#6c757d"></path>
                        </marker>
                        <marker id="wf-arrow-yes" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                            <path d="M 0 0 L 10 5 L 0 10 z" fill="#198754"></path>
                        </marker>
                        <marker id="wf-arrow-no" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                            <path d="M 0 0 L 10 5 L 0 10 z" fill="#dc3545"></path>
                        </marker>
                    </defs>
                    <g id="wf-edge-layer"></g>
                </svg>
                <div id="wf-nodes"></div>
            </div>
            <div class="wf-panel" id="wf-panel" aria-live="polite"></div>
        </div>
        <div id="check-result" class="mt-2" aria-live="polite"></div>
        <div class="form-text mt-2">
            <em>Periksa</em> tidak menjalankan apa pun: ia memeriksa data source, module, host Rest, urutan output antar-langkah, dan setelan
            (<code>AllowWrite</code>, <code>AllowRawQuery</code>, <code>AllowStoredProcedure</code>, <code>Rakit:Workflow:AllowedHosts</code>, <code>Rakit:Mail</code>).
            Menjalankan sungguhan dilakukan dari tombol aksi di module.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Simpan</button>
    <a class="btn btn-outline-secondary" asp-area="Builder" asp-controller="Workflow" asp-action="Index">Batal</a>
</form>

@if (Model.IsEdit)
{
    <div class="border rounded p-3 mt-4">
        <h2 class="h5">Riwayat eksekusi (@Model.History.Count terbaru)</h2>
        @if (Model.History.Count == 0)
        {
            <p class="text-muted small mb-0">Belum pernah dijalankan.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Waktu</th><th>Run</th><th>Langkah</th><th>Status</th><th>Pesan</th><th class="text-end">ms</th><th>Tombol</th></tr></thead>
                    <tbody>
                        @foreach (var h in Model.History)
                        {
                            <tr>
                                <td class="text-nowrap">@h.Time.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td><code>@(h.RunId.ToString()[..8])</code></td>
                                <td>@(string.IsNullOrWhiteSpace(h.StepName) ? h.StepCode : h.StepName) <span class="text-muted">(@h.StepCode)</span></td>
                                <td>
                                    <span class="badge @(h.Status == TrackingStatus.Success ? "bg-success" : h.Status == TrackingStatus.Failed ? "bg-danger" : h.Status == TrackingStatus.RolledBack ? "bg-warning text-dark" : h.Status == TrackingStatus.Waiting ? "bg-info text-dark" : "bg-secondary")">@WorkflowDisplayText.TrackingLabel(h.Status)</span>
                                </td>
                                <td>@h.Message</td>
                                <td class="text-end">@h.DurationMs</td>
                                <td>@h.ActionCode</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/lib/ace/ace.js"></script>
    <script src="~/js/workflow-form.js" asp-append-version="true"></script>
}
