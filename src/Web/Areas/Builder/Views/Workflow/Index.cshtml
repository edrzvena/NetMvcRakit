@using Rakit.Core.Workflows
@model WorkflowIndexViewModel
@{
    ViewData["Title"] = "Workflow";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Workflow</h1>
    <a class="btn btn-primary" asp-area="Builder" asp-controller="Workflow" asp-action="Create">+ Workflow baru</a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" role="status">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<p class="small text-muted">
    Workflow adalah urutan langkah (data source) yang dijalankan tombol aksi di module Table atau Form. Pasang tombolnya di
    <a asp-area="Builder" asp-controller="Module" asp-action="Index">Module</a> pada bagian <em>Aksi</em>.
</p>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">Belum ada workflow. Buat yang pertama dengan tombol di kanan atas.</p>
}
else
{
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr><th>Kode</th><th>Nama</th><th>Langkah</th><th>Status</th><th>Diubah</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var w in Model.Items)
            {
                var published = w.Status == WorkflowStatus.Published;
                <tr>
                    <td><code>@w.Code</code></td>
                    <td>@w.Name</td>
                    <td>@w.StepCount</td>
                    <td><span class="badge @(published ? "bg-success" : "bg-secondary")">@WorkflowDisplayText.StatusLabel(w.Status)</span></td>
                    <td>@(w.Updated?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-area="Builder" asp-controller="Workflow" asp-action="Edit" asp-route-id="@w.Id">Ubah</a>
                        @if (published)
                        {
                            <form class="d-inline" method="post" asp-area="Builder" asp-controller="Workflow" asp-action="Unpublish" asp-route-id="@w.Id">
                                <button type="submit" class="btn btn-sm btn-outline-warning">Unpublish</button>
                            </form>
                        }
                        else
                        {
                            <form class="d-inline" method="post" asp-area="Builder" asp-controller="Workflow" asp-action="Publish" asp-route-id="@w.Id">
                                <button type="submit" class="btn btn-sm btn-outline-success">Publish</button>
                            </form>
                        }
                        <form class="d-inline" method="post" asp-area="Builder" asp-controller="Workflow" asp-action="Copy" asp-route-id="@w.Id">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Salin</button>
                        </form>
                        @* the name is free text: it travels in an encoded attribute, never inside a JavaScript string *@
                        <form class="d-inline" method="post" asp-area="Builder" asp-controller="Workflow" asp-action="Delete" asp-route-id="@w.Id"
                              data-confirm="Hapus workflow @w.Name?" onsubmit="return confirm(this.dataset.confirm);">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
