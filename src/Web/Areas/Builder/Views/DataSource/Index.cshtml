@model DataSourceIndexViewModel
@{
    ViewData["Title"] = "Data Source";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Data Source</h1>
    <a class="btn btn-primary" asp-area="Builder" asp-controller="DataSource" asp-action="Create">+ Data Source baru</a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" role="status">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

@if (!Model.AllowRawQuery)
{
    <div class="alert alert-info" role="note">
        Mode <strong>Query</strong> dinonaktifkan (<code>Rakit:Db:AllowRawQuery = false</code>). Data source mode Query tetap bisa
        disimpan, tapi belum bisa dijalankan atau di-preview.
    </div>
}

@if (Model.Items.Count == 0)
{
    <p class="text-muted">Belum ada data source. Buat yang pertama dengan tombol di kanan atas.</p>
}
else
{
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr><th>Code</th><th>Nama</th><th>Mode</th><th>Statement</th><th class="text-end">Versi</th><th>Diubah</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Items)
            {
                <tr>
                    <td><code>@d.Code</code></td>
                    <td>@d.Name</td>
                    <td>@DataSourceDisplay.ModeLabel(d.Mode)</td>
                    <td>@d.StatementType</td>
                    <td class="text-end">@d.Version</td>
                    <td>@(d.Updated?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-area="Builder" asp-controller="DataSource" asp-action="Edit" asp-route-id="@d.Id">Ubah</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-area="Builder" asp-controller="DataSource" asp-action="Versions" asp-route-id="@d.Id">Riwayat</a>
                        <form class="d-inline" method="post" asp-area="Builder" asp-controller="DataSource" asp-action="Delete" asp-route-id="@d.Id"
                              onsubmit="return confirm('Hapus data source @d.Code?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
