@model ModuleIndexViewModel
@{
    ViewData["Title"] = "Module";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Module</h1>
    <a class="btn btn-primary" asp-area="Builder" asp-controller="Module" asp-action="Create">+ Module baru</a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" role="status">@Model.Message</div>
}

@if (Model.Items.Count == 0)
{
    <p class="text-muted">Belum ada module. Buat yang pertama dengan tombol di kanan atas.</p>
}
else
{
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr><th>Nama</th><th>Grup</th><th>Tipe</th><th>Status</th><th>Diubah</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Items)
            {
                <tr>
                    <td>@m.Name</td>
                    <td>@(m.GroupName ?? "-")</td>
                    <td>@ModuleDisplayText.TypeLabel(m.Type)</td>
                    <td>
                        <span class="badge @(m.Status == ModuleStatus.Published ? "bg-success" : "bg-secondary")">@ModuleDisplayText.StatusLabel(m.Status)</span>
                    </td>
                    <td>@(m.Updated?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-area="Builder" asp-controller="Module" asp-action="Edit" asp-route-id="@m.Id">Ubah</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
