@model ModuleFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? $"Ubah {Model.Name}" : "Module baru";

    // One select for a record action. A saved id that is not among the options (gone, or the wrong statement type) stays
    // selected as a marked entry, so it is not dropped silently and saving reports the problem.
    // `types` = the module types that show it (data-types, toggled by module-form.js when the Tipe changes).
    async Task SourcePick(string field, string title, string help, Guid? selected, IReadOnlyList<DataSourceOption> options, string types)
    {
        <div class="col-md-6" data-types="@types">
            <label class="form-label" for="@field">@title</label>
            <select class="form-select" id="@field" name="@field">
                <option value="">- tidak ada -</option>
                @foreach (var d in options)
                {
                    <option value="@d.Id" selected="@(selected == d.Id)">@d.Code - @d.Name (@d.ModeLabel)</option>
                }
                @if (selected is { } missing && options.All(o => o.Id != missing))
                {
                    <option value="@missing" selected>(tidak ditemukan atau bertipe lain) @missing</option>
                }
            </select>
            <div class="form-text">@help</div>
        </div>
    }
}

<p><a asp-area="Builder" asp-controller="Module" asp-action="Index">&larr; Module</a></p>
<h1 class="h3 mb-3">
    @(Model.IsEdit ? "Ubah Module" : "Module baru")
    @if (Model.IsEdit)
    {
        <span class="badge fs-6 @(Model.Status == ModuleStatus.Published ? "bg-success" : "bg-secondary")">@ModuleDisplayText.StatusLabel(Model.Status)</span>
    }
</h1>

<div asp-validation-summary="All" class="alert alert-danger"></div>

@if (Model.IsEdit && Model.Id is { } moduleId)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3 small">
        <span class="text-muted">ID module</span>
        <code class="user-select-all">@moduleId</code>
        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" data-copy="@moduleId" data-bs-toggle="tooltip" title="Salin ID" aria-label="Salin ID module"><i class="bi bi-clipboard"></i></button>
        @if (Model.Status == ModuleStatus.Published)
        {
            <a class="btn btn-sm btn-outline-info py-0 px-1" target="_blank" rel="noopener" data-bs-toggle="tooltip" title="Buka halaman" aria-label="Buka halaman" asp-area="Object" asp-controller="Page" asp-action="Index" asp-route-moduleId="@moduleId"><i class="bi bi-box-arrow-up-right"></i></a>
        }
        <span class="text-muted">| dipakai di <code>{{module:@moduleId}}</code> pada module Page</span>

        @if (Model.OtherModules.Count > 0)
        {
            var sameGroup = Model.OtherModules.Where(m => m.GroupId is not null && m.GroupId == Model.GroupId).ToList();
            var otherGroups = Model.OtherModules.Except(sameGroup)
                .OrderBy(m => m.GroupName ?? "~").ThenBy(m => m.Name).GroupBy(m => m.GroupName ?? "Tanpa grup").ToList();
            <div class="dropdown ms-auto" id="module-jump">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><i class="bi bi-arrow-left-right"></i> Pindah ke module</button>
                <div class="dropdown-menu dropdown-menu-end p-2" style="width: 22rem">
                    <input type="search" class="form-control form-control-sm mb-2" id="module-jump-search" placeholder="Cari nama, tipe, atau grup" autocomplete="off" aria-label="Cari module" />
                    <div style="max-height: 18rem; overflow: auto" id="module-jump-list">
                        @if (sameGroup.Count > 0)
                        {
                            <div class="px-2 small text-muted text-uppercase" data-jump-heading>Satu grup</div>
                            @foreach (var m in sameGroup.OrderBy(m => m.Name))
                            {
                                <a class="dropdown-item small" data-jump-item data-text="@($"{m.Name} {ModuleDisplayText.TypeLabel(m.Type)} {m.GroupName}".ToLowerInvariant())" asp-area="Builder" asp-controller="Module" asp-action="Edit" asp-route-id="@m.Id">@m.Name <span class="text-muted">&middot; @ModuleDisplayText.TypeLabel(m.Type)</span></a>
                            }
                        }
                        @foreach (var group in otherGroups)
                        {
                            <div class="px-2 pt-1 small text-muted text-uppercase" data-jump-heading>@group.Key</div>
                            @foreach (var m in group)
                            {
                                <a class="dropdown-item small" data-jump-item data-text="@($"{m.Name} {ModuleDisplayText.TypeLabel(m.Type)} {m.GroupName}".ToLowerInvariant())" asp-area="Builder" asp-controller="Module" asp-action="Edit" asp-route-id="@m.Id">@m.Name <span class="text-muted">&middot; @ModuleDisplayText.TypeLabel(m.Type)</span></a>
                            }
                        }
                        <div class="px-2 small text-muted d-none" id="module-jump-empty">Tidak ada module yang cocok.</div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.IsEdit && Model.Status == ModuleStatus.Published)
{
    <div class="alert alert-info" role="note">
        Module ini <strong>Published</strong>: perubahan yang disimpan langsung berlaku di halaman runtime.
        Untuk mengerjakannya tanpa mengganggu pengguna, salin dulu modulenya lalu ubah salinan draft-nya.
    </div>
}

<form id="module-form" method="post" asp-area="Builder" asp-controller="Module" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <input type="hidden" id="ConfigJson" name="ConfigJson" value="@Model.ConfigJson" />

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-source" data-bs-toggle="tab" data-bs-target="#pane-source" type="button" role="tab" aria-controls="pane-source" aria-selected="true">Source</button>
        </li>
        <li class="nav-item" role="presentation" data-types="page">
            <button class="nav-link" id="tab-page" data-bs-toggle="tab" data-bs-target="#pane-page" type="button" role="tab" aria-controls="pane-page" aria-selected="false">Isi (HTML)</button>
        </li>
        <li class="nav-item" role="presentation" data-types="table">
            <button class="nav-link" id="tab-display" data-bs-toggle="tab" data-bs-target="#pane-display" type="button" role="tab" aria-controls="pane-display" aria-selected="false">Display</button>
        </li>
        <li class="nav-item" role="presentation" data-types="table form">
            <button class="nav-link" id="tab-form" data-bs-toggle="tab" data-bs-target="#pane-form" type="button" role="tab" aria-controls="pane-form" aria-selected="false">Form</button>
        </li>
        <li class="nav-item" role="presentation" data-types="chart">
            <button class="nav-link" id="tab-chart" data-bs-toggle="tab" data-bs-target="#pane-chart" type="button" role="tab" aria-controls="pane-chart" aria-selected="false">Chart</button>
        </li>
        <li class="nav-item" role="presentation" data-types="widget">
            <button class="nav-link" id="tab-widget"data-bs-toggle="tab" data-bs-target="#pane-widget" type="button" role="tab" aria-controls="pane-widget" aria-selected="false">Widget</button>
        </li>
        <li class="nav-item" role="presentation" data-types="table">
            <button class="nav-link" id="tab-preview" data-bs-toggle="tab" data-bs-target="#pane-preview" type="button" role="tab" aria-controls="pane-preview" aria-selected="false">Preview</button>
        </li>
        <li class="nav-item" role="presentation" data-types="widget chart">
            <button class="nav-link" id="tab-visual-preview" data-bs-toggle="tab" data-bs-target="#pane-visual-preview" type="button" role="tab" aria-controls="pane-visual-preview" aria-selected="false">Preview</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-code" data-bs-toggle="tab" data-bs-target="#pane-code" type="button" role="tab" aria-controls="pane-code" aria-selected="false"><i class="bi bi-braces"></i> Kode</button>
        </li>
    </ul>

    <div class="tab-content">
        @* ---------------- Source ---------------- *@
        <div class="tab-pane fade show active" id="pane-source" role="tabpanel" aria-labelledby="tab-source">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="Name">Nama</label>
                    <input class="form-control" id="Name" name="Name" value="@Model.Name" maxlength="200" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="@(Model.IsEdit ? "TypeLabel" : "Type")">Tipe</label>
                    @if (Model.IsEdit)
                    {
                        <input class="form-control" id="TypeLabel" value="@ModuleDisplayText.TypeLabel(Model.Type)" disabled />
                        <input type="hidden" id="Type" name="Type" value="@Model.Type" />
                        <div class="form-text">Tipe tidak bisa diubah.</div>
                    }
                    else
                    {
                        <select class="form-select" id="Type" name="Type">
                            <option value="Table" selected="@(Model.Type == ModuleType.Table)">Table (daftar + CRUD)</option>
                            <option value="Form" selected="@(Model.Type == ModuleType.Form)">Form (input berdiri sendiri)</option>
                            <option value="Page" selected="@(Model.Type == ModuleType.Page)">Page / Html (halaman bebas)</option>
                            <option value="Chart" selected="@(Model.Type == ModuleType.Chart)">Chart (grafik)</option>
                            <option value="Widget" selected="@(Model.Type == ModuleType.Widget)">Widget (kartu angka / KPI)</option>
                        </select>
                        <div class="form-text">Tidak bisa diubah setelah disimpan.</div>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="GroupId">Grup</label>
                    <select class="form-select" id="GroupId" name="GroupId">
                        <option value="">- tanpa grup -</option>
                        @foreach (var g in Model.Groups)
                        {
                            <option value="@g.Id" selected="@(Model.GroupId == g.Id)">@g.Name@(g.IsActive ? "" : " (nonaktif)")</option>
                        }
                    </select>
                    <input class="form-control form-control-sm mt-1" id="NewGroupName" name="NewGroupName" value="@Model.NewGroupName" maxlength="100" placeholder="atau buat grup baru" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="Description">Deskripsi</label>
                <textarea class="form-control" id="Description" name="Description" rows="2" maxlength="500">@Model.Description</textarea>
            </div>

            <div class="border rounded p-3 mb-3" data-types="table form" id="wizard-card">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="flex-grow-1">
                        <h2 class="h5 mb-1">Buat dari tabel</h2>
                        <p class="small text-muted mb-0">
                            Pilih tabel atau view dan kolomnya: data source List dan Detail, prosedur Tambah / Ubah / Hapus (di-whitelist otomatis),
                            kolom Display, dan field Form diisi untuk Anda. Semuanya masih bisa diubah di tab masing-masing; module baru tersimpan saat Anda menyimpan.
                        </p>
                    </div>
                    <button type="button" class="btn btn-primary" id="wizard-open"><i class="bi bi-magic"></i> Buat dari tabel...</button>
                </div>
                <div id="wizard-status" class="small mt-2" aria-live="polite"></div>
            </div>

            <div class="border rounded p-3 mb-3" data-types="table widget chart">
                <h2 class="h5" id="list-source-title" data-title-table="Sumber data: List" data-title-widget="Sumber data: Nilai (baris pertama dipakai)" data-title-chart="Sumber data: Data grafik">Sumber data: List</h2>
                @if (Model.DataSourceUnavailable)
                {
                    <div class="alert alert-warning">
                        Data source yang tersimpan sudah tidak ada atau bukan lagi bertipe Query. Pilih data source lain sebelum menyimpan.
                    </div>
                }
                <label class="form-label" for="DataSourceId">Data source</label>
                <select class="form-select" id="DataSourceId" name="DataSourceId" required>
                    <option value="">- pilih -</option>
                    @foreach (var d in Model.DataSources)
                    {
                        <option value="@d.Id" selected="@(Model.DataSourceId == d.Id)">@d.Code - @d.Name (@d.ModeLabel)</option>
                    }
                </select>
                <div class="form-text">
                    Hanya data source bertipe Query yang bisa dipilih. Mode, prosedur, parameter, dan flag diatur di
                    <a asp-area="Builder" asp-controller="DataSource" asp-action="Index">Data Source</a>.
                    Parameter yang dibaca dari URL halaman (QueryString) otomatis tersedia untuk mapping data source.
                    <span data-types="widget">Widget hanya membaca <strong>baris pertama</strong> hasilnya; urutkan atau ringkas di data source.</span>
                    <span data-types="chart">Grafik menggambar baris hasil sesuai urutannya (sampai <em>Maks baris</em>); urutkan dan ringkas (mis. GROUP BY) di data source.</span>
                </div>
            </div>

            <div class="border rounded p-3 mb-3" data-types="table form">
                <h2 class="h5" id="record-sources-title" data-title-table="Sumber data: Aksi record (opsional)" data-title-form="Sumber data: Simpan (wajib)">Sumber data: Aksi record (opsional)</h2>
                @if (!Model.WriteEnabled)
                {
                    <div class="alert alert-warning" role="note">
                        Penulisan sedang <strong>dinonaktifkan</strong> (<code>Rakit:Db:AllowWrite = false</code>): data source bertipe Command ditolak,
                        sehingga tombol Tambah / Ubah / Hapus tidak aktif di halaman runtime. Konfigurasinya tetap bisa disimpan.
                        Nyalakan flag itu hanya di lingkungan dev; halaman belum punya login.
                    </div>
                }
                <div class="row g-3">
                    @{
                        await SourcePick("DetailDataSourceId", "Detail (muat satu record untuk diubah)",
                            "Data source Query. Kunci record masuk sebagai RouteValue dengan key id.", Model.DetailDataSourceId, Model.DataSources, "table");
                        await SourcePick("InsertDataSourceId", "Tambah / Simpan (Insert)",
                            "Data source Command. Nilai form masuk sebagai FormField (key = nama field di tab Form).", Model.InsertDataSourceId, Model.CommandDataSources, "table form");
                        await SourcePick("UpdateDataSourceId", "Ubah (Update)",
                            "Data source Command. Nilai form sebagai FormField, kunci record sebagai RouteValue id.", Model.UpdateDataSourceId, Model.CommandDataSources, "table");
                        await SourcePick("DeleteDataSourceId", "Hapus (Delete)",
                            "Data source Command. Kunci record sebagai RouteValue id.", Model.DeleteDataSourceId, Model.CommandDataSources, "table");
                    }
                </div>
                <div class="form-text mt-2" data-types="table">
                    Tombol hanya muncul untuk aksi yang diisi. Prosedur yang mengembalikan nilai selain 0 dianggap gagal dan perubahannya di-rollback (0 = sukses).
                    Aksi Detail, Ubah, dan Hapus butuh <em>Kolom kunci</em> di tab Display.
                </div>
            </div>

            <div class="border rounded p-3 mb-3" data-types="table form">
                <h2 class="h5">Aksi: jalankan workflow (opsional)</h2>
                <p class="small text-muted mb-2">
                    Tiap aksi menjadi satu tombol yang menjalankan sebuah <a asp-area="Builder" asp-controller="Workflow" asp-action="Index">workflow</a>.
                    Pada module <strong>Form</strong> tombol ada di samping Simpan dan mengirim isian form (divalidasi seperti Simpan; dibaca workflow lewat
                    <code>FormField</code>). Pada module <strong>Table</strong> tombol ada di atas grid, atau di setiap baris bila <em>per baris</em> dicentang
                    (kunci baris masuk sebagai <code>RouteValue</code> <code>id</code>; butuh <em>Kolom kunci</em> di tab Display).
                    @if (!Model.WriteEnabled)
                    {
                        <span class="text-warning">Penulisan sedang dinonaktifkan (<code>Rakit:Db:AllowWrite = false</code>): langkah bertipe Command ditolak saat dijalankan.</span>
                    }
                </p>
                <div id="actions" data-workflows="@System.Text.Json.JsonSerializer.Serialize(Model.Workflows.Select(w => new { id = w.Id, label = $"{w.Name} ({w.Code})" + (w.Status == Rakit.Core.Workflows.WorkflowStatus.Published ? "" : " - draft") }))"></div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="add-action">+ Aksi</button>
            </div>
        </div>

        @* ---------------- Isi (Page / Html) ---------------- *@
        <div class="tab-pane fade" id="pane-page" role="tabpanel" aria-labelledby="tab-page">
            <div class="border rounded p-3 mb-3">
                <h2 class="h5">Isi halaman (HTML)</h2>
                <div class="alert alert-info small" role="note">
                    HTML <strong>disanitasi saat disimpan</strong> dan saat ditampilkan: script, iframe, event handler, dan markup berbahaya lain dibuang (yang tersimpan
                    adalah hasil sanitasinya). Untuk menyematkan module lain, taruh penanda <code>{{module:GUID}}</code> pada barisnya sendiri
                    (di antara tag atau di awal/akhir teks); pakai tombol <em>Sisipkan</em>. Module Table, Form, Chart, dan Widget bisa disematkan (bukan Page), maksimal @ModulePageHtml.MaxEmbeds per halaman.
                    Module yang masih Draft tampil kosong sampai dipublikasikan.
                    <br />
                    Untuk dasbor, bungkus penanda dengan kolom Bootstrap supaya widget berjajar, misalnya
                    <code>&lt;div class="row"&gt;&lt;div class="col-md-4"&gt;{{module:GUID}}&lt;/div&gt;&lt;div class="col-md-8"&gt;{{module:GUID}}&lt;/div&gt;&lt;/div&gt;</code>.
                    Query string halaman ini tidak diteruskan ke module yang disematkan.
                </div>
                <label class="form-label" for="PageHtml">HTML</label>
                <textarea class="form-control font-monospace" id="PageHtml" name="PageHtml" rows="14" spellcheck="false" maxlength="@ModulePage.MaxHtmlLength">@Model.PageHtml</textarea>
                <div class="form-text"><span id="page-html-count">0</span> / @ModulePage.MaxHtmlLength karakter</div>

                <div class="row g-2 mt-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small mb-0" for="embed-module">Sisipkan module</label>
                        <select class="form-select form-select-sm" id="embed-module">
                            <option value="">- pilih module -</option>
                            @foreach (var m in Model.EmbeddableModules)
                            {
                                <option value="@m.Id">@m.Name (@ModuleDisplayText.TypeLabel(m.Type), @ModuleDisplayText.StatusLabel(m.Status))</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="embed-insert">Sisipkan</button>
                    </div>
                    <div class="col-auto ms-auto">
                        <button type="button" class="btn btn-sm btn-success" id="page-preview-run">Preview</button>
                    </div>
                </div>
                <div id="page-preview-status" class="small text-muted mt-2" aria-live="polite"></div>
                <iframe id="page-preview-frame" class="w-100 border rounded mt-1 d-none" style="height: 360px" sandbox title="Preview halaman"></iframe>
            </div>
        </div>

        @* ---------------- Display ---------------- *@
        <div class="tab-pane fade" id="pane-display" role="tabpanel" aria-labelledby="tab-display">
            <ul class="nav nav-pills mb-3" role="tablist" id="display-subtabs">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active py-1" id="dsp-tab-props" data-bs-toggle="pill" data-bs-target="#dsp-props" type="button" role="tab" aria-controls="dsp-props" aria-selected="true">Properti dan header</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1" id="dsp-tab-columns" data-bs-toggle="pill" data-bs-target="#dsp-columns" type="button" role="tab" aria-controls="dsp-columns" aria-selected="false">Kolom</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1" id="dsp-tab-filters" data-bs-toggle="pill" data-bs-target="#dsp-filters" type="button" role="tab" aria-controls="dsp-filters" aria-selected="false">Filter</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="dsp-props" role="tabpanel" aria-labelledby="dsp-tab-props">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" for="display-title">Judul halaman</label>
                            <input class="form-control" id="display-title" maxlength="@ModuleDisplay.MaxTitleLength" placeholder="kosong = nama module" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="display-placeholder">Placeholder pencarian</label>
                            <input class="form-control" id="display-placeholder" maxlength="@ModuleDisplay.MaxSearchPlaceholderLength" placeholder="kosong = Cari..." />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label" for="take">Baris per halaman</label>
                            <input class="form-control" type="number" id="take" min="1" max="1000" value="10" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="maxTake">Maksimum per halaman</label>
                            <input class="form-control" type="number" id="maxTake" min="1" max="1000" value="100" />
                            <div class="form-text">Batas yang boleh diminta pengunjung (maks 1000).</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="keyField">Kolom kunci</label>
                            <input class="form-control" id="keyField" list="key-columns" maxlength="128" placeholder="mis. Id" />
                            <datalist id="key-columns"></datalist>
                            <div class="form-text">Kolom list yang berisi kunci record. Wajib bila ada aksi Detail, Ubah, atau Hapus.</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <h2 class="h6">Tombol</h2>
                                <div class="row row-cols-2 g-1">
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="btn-search" /><label class="form-check-label" for="btn-search">Cari</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="btn-filter" /><label class="form-check-label" for="btn-filter">Filter</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="btn-add" /><label class="form-check-label" for="btn-add">Tambah</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="btn-edit" /><label class="form-check-label" for="btn-edit">Ubah</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="btn-delete" /><label class="form-check-label" for="btn-delete">Hapus</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="btn-detail" /><label class="form-check-label" for="btn-detail">Detail (Lihat)</label></div>
                                </div>
                                <div class="form-text">
                                    Tambah, Ubah, dan Hapus tetap butuh data source-nya dan <code>Rakit:Db:AllowWrite</code>; mencentangnya saja tidak mengaktifkan.
                                    Detail menambah tombol <em>Lihat</em> per baris (baca saja) dan butuh data source Detail dan kolom kunci.
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <h2 class="h6">Menu (titik tiga)</h2>
                                <div class="row row-cols-2 g-1">
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="menu-refresh-opt" /><label class="form-check-label" for="menu-refresh-opt">Muat ulang</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="menu-export-opt" /><label class="form-check-label" for="menu-export-opt">Export halaman (CSV)</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="menu-exportAll-opt" /><label class="form-check-label" for="menu-exportAll-opt">Export semua (CSV)</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="menu-import-opt" /><label class="form-check-label" for="menu-import-opt">Import (CSV)</label></div>
                                </div>
                                <div class="form-text">
                                    Export semua membaca sampai @ModuleExport.MaxRows.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) baris yang cocok dengan pencarian dan filter.
                                    Import butuh data source Insert dan field form: tiap baris file disimpan lewat Insert dengan validasi form yang sama (maks @ModuleExport.MaxImportRows baris).
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="dsp-columns" role="tabpanel" aria-labelledby="dsp-tab-columns">
                    <div class="border rounded p-3 mb-3">
                        <h2 class="h5">Kolom</h2>
                        <div class="mb-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="load-columns">Muat kolom dari data source</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="add-column">+ Kolom</button>
                            <span id="columns-status" class="ms-2 small text-muted" aria-live="polite"></span>
                        </div>
                        <div id="columns"></div>
                        <div class="form-text">
                            Tanpa kolom, semua kolom hasil ditampilkan apa adanya (tanpa sort). Urutan di sini = urutan di halaman.
                            Sort hanya berlaku untuk kolom yang dicentang <em>sortable</em>. Kolom yang tidak lagi dikembalikan data source tetap tampil kosong.
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="dsp-filters" role="tabpanel" aria-labelledby="dsp-tab-filters">
                    <div class="border rounded p-3 mb-3">
                        <h2 class="h5">Filter</h2>
                        <p class="small text-muted mb-2">
                            Tiap filter menjadi satu isian di panel <em>Filter</em> halaman. Nilainya dikirim lewat query string dengan <strong>nama</strong> filter itu
                            (jadi bisa di-bookmark dan ikut Export); data source yang menyaringnya: di data source mode Table, tambahkan filter pada kolom dan petakan
                            parameternya ke <code>QueryString</code> dengan key yang sama. Perbandingan (sama dengan, mengandung, lebih besar, ...) ditentukan data source, bukan di sini.
                            Isian kosong tidak dikirim.
                        </p>
                        <div class="mb-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="add-filter">+ Filter</button>
                            <span class="small text-muted ms-2" id="filters-status" aria-live="polite"></span>
                        </div>
                        <div id="filters"></div>
                        <div class="form-text">
                            Tipe <strong>select</strong> memakai opsi tetap (satu per baris: <code>nilai|teks</code>) atau data source lookup (Query atau Table) dengan kolom nilai dan kolom teks.
                            Maksimal @ModuleFilter.MaxPerModule filter. Peringatan muncul saat menyimpan bila data source List tidak punya parameter dengan nama filter.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ---------------- Form ---------------- *@
        <div class="tab-pane fade" id="pane-form" role="tabpanel" aria-labelledby="tab-form">
            <div class="border rounded p-3 mb-3">
                <h2 class="h5">Field form</h2>
                <p class="small text-muted mb-2">
                    Dipakai oleh aksi Tambah dan Ubah. Hanya field di sini yang diterima dari pengunjung dan diteruskan ke data source
                    (lewat mapping FormField dengan key = nama field); kunci lain diabaikan. Field <em>readonly</em> tidak pernah diterima dari klien:
                    saat Tambah dikirim nilai <em>default</em>-nya, saat Ubah tidak dikirim sama sekali.
                </p>
                <div class="row g-2 mb-2 align-items-end">
                    <div class="col-auto">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="add-field">+ Field</button>
                    </div>
                    <div class="col-md-2" data-types="table">
                        <label class="form-label small mb-0" for="suggest-key">Kunci contoh (opsional)</label>
                        <input class="form-control form-control-sm" id="suggest-key" placeholder="mis. 1" />
                    </div>
                    <div class="col-auto" data-types="table">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="suggest-fields">Sarankan field dari Detail</button>
                    </div>
                    <div class="col-auto"><span id="fields-status" class="small text-muted" aria-live="polite"></span></div>
                </div>
                <div id="fields"></div>
                <div class="form-text">
                    Saran field membaca kolom data source Detail (lewat jalur preview, tanpa menyimpan apa pun); dengan kunci contoh, tipe ditebak dari nilainya.
                    Kolom kunci tidak disarankan. Tanggal ditulis <code>yyyy-MM-dd</code> pada <em>default</em>. MaxLength dan Regex untuk text, textarea, select, browse, email, dan url;
                    Regex harus cocok dengan seluruh nilai.
                    <br />
                    Baris kedua dan ketiga tiap field: <strong>placeholder</strong>, <strong>teks bantuan</strong>, <strong>ukuran kolom</strong> (dari 12 kolom, untuk membuat form berjajar), <strong>min / maks / step</strong> (number, date, dateTime), dan <strong>opsi tetap</strong> untuk Select (<code>nilai|teks</code> per baris, tanpa data source).
                    Tipe <strong>Seksi</strong> hanya judul pemisah antar field (dan teks bantuan di bawahnya), bukan field data.
                    <br />
                    <strong>Select</strong> = dropdown (sampai 200 pilihan), <strong>Browse</strong> = modal cari dan pilih (per 50). Keduanya mengambil pilihan dari data source
                    Query (yang sama dengan daftar data source List): kolom <em>nilai</em> yang disimpan sebagai teks dan kolom <em>teks</em> yang dibaca pengguna. Data source
                    lookup yang bisa dicari perlu parameter <code>@@Search</code> (dan <code>@@Skip</code>/<code>@@Take</code> untuk paging).
                </div>
            </div>
        </div>

        @* ---------------- Chart ---------------- *@
        <div class="tab-pane fade" id="pane-chart" role="tabpanel" aria-labelledby="tab-chart">
            <div class="border rounded p-3 mb-3">
                <h2 class="h5">Grafik</h2>
                <p class="small text-muted">
                    Setiap baris hasil data source menjadi satu kategori (dari <em>kolom label</em>); setiap <em>seri</em> adalah satu kolom angka.
                    Baris diambil sesuai urutan hasilnya sampai <em>Maks baris</em>, jadi urutkan dan ringkas di data source.
                </p>
                <div class="mb-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="chart-load-columns">Muat kolom dari data source</button>
                    <span id="chart-columns-status" class="ms-2 small text-muted" aria-live="polite"></span>
                </div>
                <datalist id="chart-columns"></datalist>
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label" for="chart-kind">Jenis</label>
                        <select class="form-select" id="chart-kind">
                            <option value="bar">Batang (bar)</option>
                            <option value="line">Garis (line)</option>
                            <option value="area">Area</option>
                            <option value="pie">Pie</option>
                            <option value="doughnut">Doughnut</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="chart-labelField">Kolom label (kategori)</label>
                        <input class="form-control" id="chart-labelField" list="chart-columns" maxlength="@ModuleWidget.MaxFieldLength" placeholder="mis. Bulan" autocomplete="off" />
                        <div class="form-text text-warning d-none" id="chart-labelField-warn">Kolom ini tidak ada di hasil data source.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="chart-title">Judul</label>
                        <input class="form-control" id="chart-title" maxlength="@ModuleChart.MaxTitleLength" placeholder="opsional" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="chart-maxRows">Maks baris</label>
                        <input class="form-control" type="number" id="chart-maxRows" min="1" max="@ModuleChart.HardMaxRows" value="@ModuleChart.DefaultMaxRows" />
                    </div>
                </div>
                <div class="mb-3">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="chart-stacked" />
                        <label class="form-check-label" for="chart-stacked">Bertumpuk (stacked)</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="chart-horizontal" />
                        <label class="form-check-label" for="chart-horizontal">Horizontal (batang)</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="chart-legend" checked />
                        <label class="form-check-label" for="chart-legend">Legenda</label>
                    </div>
                    <div class="form-text">
                        Bertumpuk untuk batang, garis, dan area; horizontal hanya untuk batang. Legenda hanya tampil bila ada dua seri atau lebih, atau untuk pie / doughnut
                        (satu seri dijelaskan oleh judul).
                    </div>
                </div>

                <h3 class="h6">Seri (maksimal @ModuleChart.MaxSeries)</h3>
                <div id="chart-series"></div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="chart-add-series">+ Seri</button>
                <div class="form-text mt-2" id="chart-series-hint">
                    Tanpa warna sendiri, seri memakai palet bawaan sesuai urutannya (biru, oranye, hijau toska, kuning, ...). Kolom seri harus berisi angka.
                </div>
                <div class="form-text d-none" id="chart-round-hint">
                    Pie dan doughnut memakai <strong>tepat satu seri</strong>; irisannya selalu berwarna palet bawaan (warna seri diabaikan) dan irisan setelah yang ketujuh
                    digabung menjadi "Lainnya".
                </div>
            </div>
        </div>

        @* ---------------- Widget ---------------- *@
        <div class="tab-pane fade" id="pane-widget" role="tabpanel" aria-labelledby="tab-widget">
            <div class="border rounded p-3 mb-3">
                <h2 class="h5">Kartu widget</h2>
                <p class="small text-muted">
                    Satu kartu dari <strong>baris pertama</strong> hasil data source. Nilainya diformat di server, jadi halaman runtime menampilkan persis seperti preview.
                </p>
                <div class="mb-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="widget-load-columns">Muat kolom dari data source</button>
                    <span id="widget-columns-status" class="ms-2 small text-muted" aria-live="polite"></span>
                </div>
                <datalist id="widget-columns"></datalist>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="widget-valueField">Kolom nilai</label>
                        <input class="form-control" id="widget-valueField" list="widget-columns" maxlength="128" placeholder="mis. Total" autocomplete="off" />
                        <div class="form-text text-warning d-none" id="widget-valueField-warn">Kolom ini tidak ada di hasil data source.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="widget-label">Label tetap</label>
                        <input class="form-control" id="widget-label" maxlength="100" placeholder="mis. Pelanggan" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="widget-labelField">Atau kolom label</label>
                        <input class="form-control" id="widget-labelField" list="widget-columns" maxlength="128" placeholder="kosong = pakai label tetap" autocomplete="off" />
                        <div class="form-text" id="widget-labelField-help">Bila diisi dan tidak kosong, kolom ini menang atas label tetap.</div>
                        <div class="form-text text-warning d-none" id="widget-labelField-warn">Kolom ini tidak ada di hasil data source.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="widget-format">Format nilai</label>
                        <select class="form-select" id="widget-format">
                            <option value="number">Number</option>
                            <option value="text">Text</option>
                            <option value="date">Date</option>
                            <option value="dateTime">DateTime</option>
                            <option value="boolean">Boolean</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="widget-decimals">Desimal</label>
                        <input class="form-control" type="number" id="widget-decimals" min="0" max="@ModuleWidget.MaxDecimals" value="0" />
                        <div class="form-text">Hanya untuk Number.</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="widget-prefix">Awalan</label>
                        <input class="form-control" id="widget-prefix" maxlength="@ModuleWidget.MaxAffixLength" placeholder="mis. Rp " />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="widget-suffix">Akhiran</label>
                        <input class="form-control" id="widget-suffix" maxlength="@ModuleWidget.MaxAffixLength" placeholder="mis. %" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="widget-color">Warna kartu</label>
                        <select class="form-select" id="widget-color">
                            @foreach (var c in ModuleWidget.Colors)
                            {
                                <option value="@c">@(char.ToUpperInvariant(c[0]) + c[1..])</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="widget-refreshSeconds">Muat ulang otomatis (detik)</label>
                        <input class="form-control" type="number" id="widget-refreshSeconds" min="0" max="@ModuleWidget.MaxRefreshSeconds" value="0" />
                        <div class="form-text">0 = tidak; selain itu @ModuleWidget.MinRefreshSeconds sampai @ModuleWidget.MaxRefreshSeconds.</div>
                    </div>
                </div>
            </div>
        </div>

        @* ---------------- Preview (Widget) ---------------- *@
        <div class="tab-pane fade" id="pane-visual-preview" role="tabpanel" aria-labelledby="tab-visual-preview">
            <div class="border rounded p-3 mb-3">
                <h2 class="h5">Preview (Draft)</h2>
                <div class="row g-2 mb-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small" for="visual-preview-query">Query string halaman</label>
                        <input class="form-control form-control-sm" id="visual-preview-query" placeholder="mis. id=2" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-sm btn-success" id="visual-preview-run">Run Preview</button>
                    </div>
                </div>
                <span id="visual-preview-status" class="small text-muted" aria-live="polite"></span>
                <div id="visual-preview-host" class="mt-2" aria-live="polite"></div>
                <div class="form-text mt-2">
                    Memakai isi form yang sedang diisi (tanpa perlu disimpan) dan jalur preview data source: hanya statement Query, maksimal 50 baris,
                    prosedur dijalankan di dalam transaksi yang di-rollback. Digambar dengan renderer yang sama dengan halaman runtime.
                    <span data-types="widget">Muat ulang otomatis tidak berjalan di preview.</span>
                    <span data-types="chart">Kolom seri yang bukan angka dilaporkan sebagai error di sini, sedangkan di halaman runtime nilainya menjadi celah.</span>
                </div>
            </div>
        </div>

        @* ---------------- Kode ---------------- *@
        <div class="tab-pane fade" id="pane-code" role="tabpanel" aria-labelledby="tab-code">
            <div class="border rounded p-3 mb-3">
                <h2 class="h5">Kode (JSON)</h2>
                <p class="small text-muted mb-2">
                    Seluruh pengaturan module di tab lain dalam satu JSON, termasuk data source yang dipilih (<code>source</code>). Ubah di sini lalu klik
                    <strong>Terapkan</strong> untuk memuat ulang semua tab; JSON yang tidak valid tidak mengubah apa pun. Isi tab ini dimuat ulang tiap kali dibuka,
                    dan baru tersimpan saat module disimpan (dengan validasi yang sama seperti biasa).
                </p>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-primary" id="code-apply"><i class="bi bi-check2"></i> Terapkan</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="code-reload"><i class="bi bi-arrow-clockwise"></i> Muat ulang dari formulir</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="code-copy"><i class="bi bi-clipboard"></i> Salin</button>
                    <span id="code-status" class="small text-muted" aria-live="polite"></span>
                </div>
                <div class="pg-editor-wrap" style="height: 420px"><div id="code-editor" aria-label="Editor JSON config module"></div></div>
            </div>
        </div>

        @* ---------------- Preview ---------------- *@
        <div class="tab-pane fade" id="pane-preview" role="tabpanel" aria-labelledby="tab-preview">
            <div class="border rounded p-3 mb-3">
                <h2 class="h5">Preview (Draft)</h2>
                <div class="row g-2 mb-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small" for="preview-query">Query string halaman</label>
                        <input class="form-control form-control-sm" id="preview-query" placeholder="mis. id=2&amp;q=abc" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small" for="preview-search">Cari</label>
                        <input class="form-control form-control-sm" id="preview-search" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-sm btn-success" id="run-preview">Run Preview</button>
                    </div>
                </div>
                <span id="preview-status" class="small text-muted" aria-live="polite"></span>
                <div id="preview-result" class="mt-2" aria-live="polite"></div>
                <div class="form-text">
                    Memakai isi form yang sedang diisi (tanpa perlu disimpan) dan jalur preview data source: hanya statement Query, maksimal 50 baris,
                    prosedur dijalankan di dalam transaksi yang di-rollback. Klik judul kolom <em>sortable</em> untuk mencoba sort.
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Simpan</button>
    <a class="btn btn-outline-secondary" asp-area="Builder" asp-controller="Module" asp-action="Index">Batal</a>
    <span class="text-muted small ms-2">
        Hak akses (<code>access</code>) disimpan tapi belum ditegakkan: halaman masih terbuka sampai login dibuat.
    </span>
</form>

@* ---------------- "Buat dari tabel" wizard (outside the form: Enter in it must not submit the module) ---------------- *@
<div class="modal fade" id="wizard-modal" tabindex="-1" aria-labelledby="wizard-title" aria-hidden="true" data-can-procedures="@(Model.CanCreateProcedures ? "1" : "0")">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h5" id="wizard-title">Buat dari tabel</h2>
                    <div class="small text-muted" id="wizard-steps">Langkah 1 dari 3: tabel</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="modal-body">
                <div id="wizard-error" class="alert alert-danger d-none" role="alert"></div>

                <div id="wizard-step-1">
                    <label class="form-label" for="wizard-filter">Tabel atau view</label>
                    <input type="search" class="form-control mb-2" id="wizard-filter" placeholder="Cari tabel" autocomplete="off" />
                    <select class="form-select" id="wizard-table" size="9" aria-label="Daftar tabel dan view"></select>
                    <div class="form-text">Hanya tabel dan view di schema yang diizinkan (<code>Rakit:Db:AllowedSchemas</code>).</div>
                </div>

                <div id="wizard-step-2" class="d-none">
                    <div id="wizard-table-notes"></div>
                    <div class="d-flex flex-wrap align-items-end gap-3 mb-2">
                        <div>
                            <label class="form-label mb-0" for="wizard-key">Kolom kunci</label>
                            <select class="form-select form-select-sm" id="wizard-key" style="min-width: 14rem"></select>
                        </div>
                        <div class="ms-auto d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="wizard-all">Pilih semua</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="wizard-none">Kosongkan</button>
                        </div>
                    </div>
                    <div class="table-responsive" style="max-height: 24rem; overflow: auto">
                        <table class="table table-sm align-middle mb-0" id="wizard-columns">
                            <thead><tr><th style="width: 2.5rem"></th><th>Kolom</th><th>Tipe</th><th>Ciri</th><th class="text-center" title="Jadi isian filter di halaman">Filter</th><th>Keterangan</th></tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="form-text">Kolom yang dicentang tampil di list dan masuk ke data source. Kolom kunci selalu ikut. <strong>Filter</strong> membuat isian di panel Filter halaman (teks = mengandung, lainnya = sama dengan) dan filter di data source List.</div>
                </div>

                <div id="wizard-step-3" class="d-none">
                    <p class="mb-2">Aksi yang dibuat untuk module ini:</p>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="wizard-insert" /><label class="form-check-label" for="wizard-insert">Tambah (Insert)</label></div>
                    <div class="form-check" data-wizard-key-only><input class="form-check-input" type="checkbox" id="wizard-update" /><label class="form-check-label" for="wizard-update">Ubah (Update)</label></div>
                    <div class="form-check" data-wizard-key-only><input class="form-check-input" type="checkbox" id="wizard-delete" /><label class="form-check-label" for="wizard-delete">Hapus (Delete)</label></div>
                    <div class="alert alert-warning small mt-3 d-none" id="wizard-no-procedures" role="note">
                        Membuat prosedur butuh <code>Rakit:Playground:Enabled = true</code> dan <code>Rakit:Playground:AllowWrite = true</code> (khusus pengembangan),
                        jadi Tambah, Ubah, dan Hapus dimatikan. List dan Detail tetap dibuat.
                    </div>
                    <div class="small text-muted mt-3" id="wizard-summary"></div>
                    <div class="small text-muted mt-2">
                        Aksi tulis dibuat sebagai prosedur <code>Sp&lt;Tabel&gt;_Insert/Update/Delete</code> di schema tabel (ditandai <code>rakit:generated</code>, otomatis masuk SP Whitelist);
                        prosedur milik Anda dengan nama yang sama tidak ditimpa. Menjalankan tombol tulis di halaman tetap butuh <code>Rakit:Db:AllowWrite</code>.
                    </div>
                </div>

                <div id="wizard-done" class="d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary me-auto" data-bs-dismiss="modal" id="wizard-cancel">Batal</button>
                <button type="button" class="btn btn-outline-secondary" id="wizard-back">Kembali</button>
                <button type="button" class="btn btn-primary" id="wizard-next">Lanjut</button>
                <button type="button" class="btn btn-success d-none" id="wizard-apply"><i class="bi bi-check2"></i> Terapkan</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/js/chart-render.js" asp-append-version="true"></script>
    <script src="~/lib/ace/ace.js"></script>
    <script src="~/js/copy-id.js" asp-append-version="true"></script>
    <script src="~/js/module-form.js" asp-append-version="true"></script>
    <script src="~/js/module-wizard.js" asp-append-version="true"></script>
    <script src="~/js/module-code.js" asp-append-version="true"></script>
}

