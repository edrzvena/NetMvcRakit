@model MenuFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Ubah Menu" : "Menu baru";
}

<p><a asp-area="Builder" asp-controller="Menu" asp-action="Index">&larr; Menu</a></p>
<h1 class="h3 mb-3">@(Model.IsEdit ? "Ubah Menu" : "Menu baru")</h1>

<div asp-validation-summary="All" class="alert alert-danger"></div>

<form id="menu-form" method="post" asp-area="Builder" asp-controller="Menu" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <div class="mb-3">
        <span class="form-label d-block">Jenis</span>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="TargetType" id="t-module" value="Module" checked="@(Model.TargetType == MenuTargetType.Module)" />
            <label class="form-check-label" for="t-module">Module</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="TargetType" id="t-url" value="Url" checked="@(Model.TargetType == MenuTargetType.Url)" />
            <label class="form-check-label" for="t-url">URL</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="TargetType" id="t-folder" value="Folder" checked="@(Model.TargetType == MenuTargetType.Folder)" />
            <label class="form-check-label" for="t-folder">Folder (dropdown)</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="TargetType" id="t-delimiter" value="Delimiter" checked="@(Model.TargetType == MenuTargetType.Delimiter)" />
            <label class="form-check-label" for="t-delimiter">Pemisah</label>
        </div>
        @if (Model.HasChildren)
        {
            <div class="form-text">Item ini punya anak: sebagai folder atau item biasa ia jadi judul dropdown (tujuannya tidak dipakai selama punya anak).</div>
        }
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-5" id="field-label">
            <label class="form-label" for="Label">Label</label>
            <input class="form-control" id="Label" name="Label" value="@Model.Label" maxlength="100" />
        </div>
        <div class="col-md-3" id="field-icon">
            <label class="form-label" for="Icon">Ikon</label>
            <input class="form-control" id="Icon" name="Icon" value="@Model.Icon" maxlength="50" placeholder="mis. bi-people" />
            <div class="form-text">Nama saja (huruf/angka/_/-). Disimpan; belum ditampilkan karena belum ada font ikon.</div>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="Order">Urutan</label>
            <input class="form-control" type="number" id="Order" name="Order" value="@Model.Order" />
            <div class="form-text">Kecil tampil dulu.</div>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true" checked="@Model.IsActive" />
                <label class="form-check-label" for="IsActive">Aktif</label>
                <input type="hidden" name="IsActive" value="false" />
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6" id="field-module">
            <label class="form-label" for="ModuleId">Module</label>
            <select class="form-select" id="ModuleId" name="ModuleId">
                <option value="">- pilih -</option>
                @foreach (var m in Model.Modules)
                {
                    <option value="@m.Id" selected="@(Model.ModuleId == m.Id)">@m.Label</option>
                }
            </select>
            <div class="form-text">Menu hanya tampil bila modulenya Published.</div>
        </div>
        <div class="col-md-6" id="field-url">
            <label class="form-label" for="Url">URL</label>
            <input class="form-control" id="Url" name="Url" value="@Model.Url" maxlength="500" placeholder="/Admin/Health atau https://..." />
            <div class="form-text">Alamat di aplikasi ini (diawali <code>/</code>) atau <code>http(s)://</code>.</div>
        </div>
        <div class="col-md-6" id="field-parent">
            <label class="form-label" for="ParentId">Induk (folder)</label>
            <select class="form-select" id="ParentId" name="ParentId" disabled="@Model.HasChildren">
                <option value="">- tingkat atas -</option>
                @foreach (var p in Model.Parents)
                {
                    <option value="@p.Id" selected="@(Model.ParentId == p.Id)">@p.Label</option>
                }
            </select>
            @if (Model.HasChildren)
            {
                <div class="form-text">Item yang punya anak tidak bisa dipindah ke dalam item lain (maksimal dua tingkat).</div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Simpan</button>
    <a class="btn btn-outline-secondary" asp-area="Builder" asp-controller="Menu" asp-action="Index">Batal</a>
</form>

@section Scripts {
    <script src="~/js/menu-form.js" asp-append-version="true"></script>
}
