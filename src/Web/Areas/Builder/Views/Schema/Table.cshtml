@model TableDetailViewModel
@{
    ViewData["Title"] = $"{Model.Schema}.{Model.Name}";
}

<p><a asp-area="Builder" asp-controller="Schema" asp-action="Index">&larr; Schema Browser</a></p>
<h1 class="h3 mb-3">@Model.Schema.@Model.Name</h1>

<table class="table table-sm">
    <thead><tr><th>#</th><th>Kolom</th><th>Tipe</th><th>Nullable</th></tr></thead>
    <tbody>
        @{ var i = 0; }
        @foreach (var c in Model.Columns)
        {
            i++;
            <tr>
                <td>@i</td>
                <td>@c.Name</td>
                <td>@SchemaDisplay.TypeLabel(c.DataType, c.MaxLength, c.Precision, c.Scale)</td>
                <td>@(c.IsNullable ? "ya" : "tidak")</td>
            </tr>
        }
    </tbody>
</table>
